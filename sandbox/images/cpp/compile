#!/bin/sh
# --as-needed drops libraries the program doesn't use, so linking them all is free.
# - libstb provides the stb implementations: `#include <stb/stb_image_write.h>` needs no #define.
# - GL_GLEXT_PROTOTYPES makes <GL/gl.h> declare modern OpenGL functions too (glCreateShader, ...);
#   OSMesa exports all of them, so no loader (glad, GLEW) is needed.
exec clang++-18 -std=c++20 -Wall -I/usr/include/eigen3 -I/usr/include/stb -DGL_GLEXT_PROTOTYPES \
    -o /box/main.out /box/main.cpp \
    -Wl,--as-needed -lfmt -lstb -lOSMesa -lGLU -lGL -lEGL -lm -lpthread
